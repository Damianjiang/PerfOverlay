<Window x:Class="PerfOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PerfOverlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border x:Name="RootBorder" CornerRadius="6" Padding="10,8">
        <StackPanel x:Name="TextPanel" TextOptions.TextFormattingMode="Display">
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1.5" Direction="270" Opacity="0.9" Color="Black"/>
            </StackPanel.Effect>
            <TextBlock x:Name="CpuText" Text="CPU  --" FontSize="15" FontFamily="Consolas, Microsoft YaHei UI"/>
            <TextBlock x:Name="RamText" Text="内存 --" FontSize="15" FontFamily="Consolas, Microsoft YaHei UI"/>
            <TextBlock x:Name="NetText" Text="↓ --    ↑ --" FontSize="15" FontFamily="Consolas, Microsoft YaHei UI"/>
            <TextBlock x:Name="GpuText" Text="GPU  --" FontSize="15" FontFamily="Consolas, Microsoft YaHei UI"/>
        </StackPanel>
    </Border>
</Window>
